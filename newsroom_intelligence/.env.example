# Newsroom Intelligence Configuration
# Copy to .env and customize for your environment

# Application
APP_NAME=newsroom-intelligence
DEBUG=false

# Logging
LOG_LEVEL=INFO
# LOG_FILE=./logs/newsroom.log

# Database
DATABASE_URL=sqlite:///./newsroom.db
# DATABASE_URL=postgresql://user:password@localhost/newsroom
DATABASE_ECHO=false

# HTTP
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY_SECONDS=1.0

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Notifications
# DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/...
NOTIFICATION_MIN_CONFIDENCE=0.5
