#!/usr/bin/env bash
# Launch the Free Game Tracker dashboard locally, bound to localhost only,
# against the isolated local dev database. Never the production DB, never
# a production webhook (this script unsets NEWSROOM_DISCORD_WEBHOOK_URL
# unconditionally, regardless of what's in the calling shell's environment).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [ ! -x ".venv/bin/newsroom" ]; then
    echo "error: no .venv found. Run mac/bootstrap first." >&2
    exit 1
fi

PORT="${FGT_MAC_PORT:-8765}"
mkdir -p .mac-dev/reports
export NEWSROOM_DATABASE_PATH="${REPO_ROOT}/.mac-dev/newsroom.db"
export NEWSROOM_REPORTS_DIR="${REPO_ROOT}/.mac-dev/reports"
unset NEWSROOM_DISCORD_WEBHOOK_URL

echo "==> Local dev DB: .mac-dev/newsroom.db (isolated, not production)"
echo "==> Dashboard:     http://127.0.0.1:${PORT}/"
echo "    (Ctrl+C to stop)"
echo ""

exec .venv/bin/newsroom serve --host 127.0.0.1 --port "$PORT"
