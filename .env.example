# Copy to .env and adjust as needed. All variables are optional; defaults are
# sensible for local use. Every variable is prefixed with NEWSROOM_.

# NEWSROOM_DATABASE_PATH=./newsroom.db
# NEWSROOM_DATABASE_ECHO=false

# NEWSROOM_HTTP_TIMEOUT_SECONDS=30
# NEWSROOM_HTTP_MAX_RETRIES=3
# NEWSROOM_HTTP_RETRY_BACKOFF_SECONDS=2

# NEWSROOM_REPORTS_DIR=./reports
# NEWSROOM_LOG_LEVEL=INFO

# Discord notifications (optional). Set the webhook URL to enable alerts for
# newly free games. Leave unset to disable notifications entirely.
# NEWSROOM_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Quality gate — controls what surfaces to reports and Discord (the database
# always keeps the full record). Defaults below are permissive (no filtering).
# NEWSROOM_MIN_CONFIDENCE=0        # 0-100; e.g. 70 drops shaky detections
# NEWSROOM_REQUIRE_KNOWN_PRICE=false  # true drops giveaways with no real MSRP
# NEWSROOM_MIN_PRICE=0             # minimum known MSRP to surface

# Breakout new releases (Steam) — well-reviewed recent launches (optional).
# NEWSROOM_ENABLE_BREAKOUTS=true
# NEWSROOM_BREAKOUT_MAX_DAYS=14              # consider games released within N days
# NEWSROOM_BREAKOUT_MIN_REVIEW_TIER=Very Positive  # or 'Overwhelmingly Positive'

# Steam deals — substantial discounts on well-reviewed games (optional).
# NEWSROOM_ENABLE_DEALS=true
# NEWSROOM_DEAL_MIN_DISCOUNT_PERCENT=30       # at least this % off (100% = free, elsewhere)
# NEWSROOM_DEAL_MIN_REVIEW_TIER=Mixed         # floor: Mixed and up
# NEWSROOM_DEAL_MIN_REVIEWS=1000              # exclude thinly-reviewed shovelware

# Housekeeping and health (optional).
# NEWSROOM_REPORT_RETENTION_DAYS=30   # delete reports older than this (0 = keep)
# NEWSROOM_SOURCE_STALE_HOURS=6       # warn if a source hasn't succeeded in this long
# NEWSROOM_GAMERPOWER_UTC_OFFSET_HOURS=0  # shift GamerPower end dates (e.g. 5 if US Eastern)
